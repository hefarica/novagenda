# App
PORT=3000
APP_URL=http://localhost:3000
APP_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
DATA_DIR=./data
TIMEZONE=America/Bogota

# Google OAuth (Calendar + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En Google Cloud autoriza: ${APP_URL}/api/auth/google/callback

# WhatsApp Business Platform / Cloud API
WA_ENABLED=false
WA_API_VERSION=v25.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_DEFAULT_TO=
# Para recordatorios proactivos fuera de la ventana de servicio, usa una plantilla aprobada.
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANGUAGE=es_CO

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Notificaciones por correo (se envían desde una cuenta Google conectada)
EMAIL_ENABLED=false
NOTIFY_EMAIL_TO=

# IA opcional: si se omite, el parser local en español sigue funcionando.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
